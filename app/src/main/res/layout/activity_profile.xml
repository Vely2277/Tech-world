<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_secondary">

    <!-- Main Content -->
    <LinearLayout
        android:id="@+id/profileContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Modern Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_header_modern"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:elevation="4dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_header_icon"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/backArrow"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="My Profile"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

        <!-- Scrollable Content -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/profileScrollContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Profile Header Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/profileHeaderSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <!-- Profile Picture with Upload Capability -->
                        <FrameLayout
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            android:foreground="?android:attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true">

                            <!-- Background Ring -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/circle_background"
                                android:backgroundTint="@color/colorPrimary"
                                android:alpha="0.15" />

                            <ImageView
                                android:id="@+id/profilePicture"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:layout_gravity="center"
                                android:background="@drawable/circle_background"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_profile_placeholder" />

                            <!-- Camera Overlay for empty state -->
                            <View
                                android:id="@+id/headerCameraOverlay"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:layout_gravity="center"
                                android:background="@drawable/circle_background"
                                android:backgroundTint="#80000000"
                                android:alpha="0.7"
                                android:visibility="visible" />

                            <!-- Camera Icon for empty state -->
                            <ImageView
                                android:id="@+id/headerCameraIcon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_camera"
                                app:tint="@android:color/white"
                                android:alpha="0.9"
                                android:visibility="visible" />

                            <!-- Small edit icon for when profile picture exists -->
                            <FrameLayout
                                android:id="@+id/headerEditAvatarIcon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="bottom|end"
                                android:layout_marginEnd="2dp"
                                android:layout_marginBottom="2dp"
                                android:background="@drawable/circle_background"
                                android:backgroundTint="@color/colorPrimary"
                                android:visibility="gone">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_camera"
                                    app:tint="@color/white" />
                            </FrameLayout>

                            <!-- Upload Progress -->
                            <ProgressBar
                                android:id="@+id/headerUploadProgress"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:indeterminate="true"
                                android:indeterminateTint="@color/colorPrimary"
                                android:visibility="gone" />

                        </FrameLayout>

                        <!-- Username -->
                        <TextView
                            android:id="@+id/profileUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="User Name"
                            android:textSize="22sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary" />

                        <!-- Seller Level Badge -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_price_badge"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="6dp"
                                android:src="@drawable/ic_star"
                                app:tint="@color/success" />

                            <TextView
                                android:id="@+id/profileStarText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="New Seller"
                                android:textSize="13sp"
                                android:textColor="@color/success"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <!-- Description -->
                        <TextView
                            android:id="@+id/profiledescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text=""
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"
                            android:gravity="center_horizontal" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Tab Section -->
                <LinearLayout
                    android:id="@+id/tabSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabLayout"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_tab_background"
                        app:tabIndicatorColor="@color/colorPrimary"
                        app:tabIndicatorHeight="3dp"
                        app:tabIndicatorFullWidth="false"
                        app:tabSelectedTextColor="@color/colorPrimary"
                        app:tabTextColor="@color/text_secondary"
                        app:tabRippleColor="@color/colorPrimaryLight"
                        app:tabTextAppearance="@style/TabTextAppearance" />

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/profileLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_secondary"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:id="@+id/profileLoadingIndicator"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Loading profile..."
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
