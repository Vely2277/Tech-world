<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/colorPrimary"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Terms &amp; Conditions"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- Content ScrollView -->
    <ScrollView
        android:id="@+id/termsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="20dp"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/agreementSection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Welcome Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome to Real Pakistan"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last Updated: December 2025"
                android:textSize="12sp"
                android:textColor="@color/gray"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Please read these Terms and Conditions carefully before using our application. By accessing or using our services, you agree to be bound by these terms."
                android:textSize="14sp"
                android:textColor="@color/black"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="24dp" />

            <!-- Section 1 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Acceptance of Terms"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="By creating an account and using Real Pakistan, you acknowledge that you have read, understood, and agree to be bound by these Terms and Conditions. If you do not agree with any part of these terms, you must not use our services."
                android:textSize="14sp"
                android:textColor="@color/darkGray"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="20dp" />

            <!-- Section 2 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. User Account and Registration"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• You must provide accurate and complete information during registration\n• You are responsible for maintaining the confidentiality of your account credentials\n• You must be at least 18 years old to create an account\n• One person may maintain only one active account\n• You are fully responsible for all activities conducted through your account"
                android:textSize="14sp"
                android:textColor="@color/darkGray"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="20dp" />

            <!-- Section 3 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Service Usage"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• You agree to use the application for lawful purposes only\n• You will not engage in any fraudulent or malicious activities\n• You will respect the rights and privacy of other users\n• You will not attempt to gain unauthorized access to any part of the application\n• You will comply with all applicable local, state, and international laws"
                android:textSize="14sp"
                android:textColor="@color/darkGray"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="20dp" />

            <!-- Section 4 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. User Content and Conduct"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• You retain ownership of content you submit or upload\n• You grant us license to use, display, and distribute your content within the application\n• You are solely responsible for the content you post\n• Content must not be illegal, offensive, defamatory, or infringing on third-party rights\n• We reserve the right to remove any content that violates these terms"
                android:textSize="14sp"
                android:textColor="@color/darkGray"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="20dp" />

            <!-- Section 5 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. Privacy and Data Protection"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• We are committed to protecting your privacy and personal information\n• Your data will be collected, used, and stored in accordance with our Privacy Policy\n• We implement industry-standard security measures to protect your data\n• You have the right to access, modify, or delete your personal information\n• We will never sell your personal information to third parties"
                android:textSize="14sp"
                android:textColor="@color/darkGray"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="20dp" />

            <!-- Section 6 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6. Payments and Transactions"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• All transactions are conducted through secure payment gateways\n• You agree to pay all applicable fees and charges\n• Refunds are subject to our refund policy\n• We are not responsible for payment processing delays by third-party providers\n• You must report any unauthorized transactions immediately"
                android:textSize="14sp"
                android:textColor="@color/darkGray"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="20dp" />

            <!-- Section 7 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="7. Intellectual Property"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• All content, trademarks, logos, and intellectual property are owned by Real Pakistan or its licensors\n• You may not copy, modify, or distribute any content without express permission\n• Unauthorized use of our intellectual property is strictly prohibited\n• You grant us a non-exclusive license to use your content for service provision"
                android:textSize="14sp"
                android:textColor="@color/darkGray"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="20dp" />

            <!-- Section 8 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="8. Service Availability and Modifications"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• We strive to maintain uninterrupted service but cannot guarantee 100% uptime\n• We reserve the right to modify, suspend, or discontinue services at any time\n• We may update these terms periodically, and continued use constitutes acceptance\n• Scheduled maintenance will be communicated in advance when possible"
                android:textSize="14sp"
                android:textColor="@color/darkGray"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="20dp" />

            <!-- Section 9 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="9. Limitation of Liability"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• The service is provided &quot;as is&quot; without warranties of any kind\n• We are not liable for any indirect, incidental, or consequential damages\n• Our total liability shall not exceed the amount paid by you in the past 12 months\n• Some jurisdictions do not allow limitation of liability, so these limits may not apply to you"
                android:textSize="14sp"
                android:textColor="@color/darkGray"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="20dp" />

            <!-- Section 10 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="10. Termination"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• You may terminate your account at any time by contacting support\n• We reserve the right to suspend or terminate accounts that violate these terms\n• Upon termination, your access to services will cease immediately\n• Some provisions of these terms will survive termination"
                android:textSize="14sp"
                android:textColor="@color/darkGray"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="20dp" />

            <!-- Section 11 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="11. Dispute Resolution"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Any disputes will be resolved through binding arbitration\n• You waive the right to participate in class-action lawsuits\n• The laws of Pakistan shall govern these terms\n• Any legal proceedings must be conducted in Pakistan"
                android:textSize="14sp"
                android:textColor="@color/darkGray"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="20dp" />

            <!-- Section 12 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="12. Contact Information"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="If you have any questions about these Terms and Conditions, please contact us at:\n\nEmail: support@realpakistan.com\nPhone: +92 XXX XXXXXXX\nAddress: Pakistan"
                android:textSize="14sp"
                android:textColor="@color/darkGray"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="20dp" />

            <!-- Final Note -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="By clicking &quot;Accept&quot; below, you confirm that you have read, understood, and agree to be bound by these Terms and Conditions."
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="@color/colorPrimary"
                android:lineSpacingMultiplier="1.3"
                android:padding="16dp"
                android:background="@drawable/rounded_background_light"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Agreement Section -->
    <LinearLayout
        android:id="@+id/agreementSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/white"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/lightGray"
            android:layout_marginBottom="16dp" />

        <!-- Checkbox -->
        <CheckBox
            android:id="@+id/agreeCheckBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I have read and agree to the Terms and Conditions"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:buttonTint="@color/colorPrimary"
            android:layout_marginBottom="16dp" />

        <!-- Accept Button -->
        <Button
            android:id="@+id/acceptButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Accept and Continue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/button_primary_shape"
            android:elevation="2dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

