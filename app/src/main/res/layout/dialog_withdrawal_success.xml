<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Success Icon with Animation Container -->
    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="24dp">

        <!-- Background Circle -->
        <View
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/success_circle_background" />

        <!-- Success Icon -->
        <ImageView
            android:id="@+id/successIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check"
            android:contentDescription="Success checkmark"
            app:tint="#FFFFFF" />

    </FrameLayout>

    <!-- Success Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Withdrawal Initiated Successfully!"
        android:textColor="#4CAF50"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Success Message -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Funds should be received within 3-5 business days and may be instant."
        android:textColor="#616161"
        android:textSize="16sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

    <!-- Done Button -->
    <Button
        android:id="@+id/doneButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/btn_success"
        android:text="Done"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
