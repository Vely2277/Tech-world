rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read their own location-tracking-settings (hyphenated version)
    match /location-tracking-settings/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only backend (admin SDK) can write
    }

    // locationTrackingSettings (camelCase version - used by Android app)
    match /locationTrackingSettings/{userId} {
      allow read: if request.auth != null; // Admin can read any user's settings
      allow write: if request.auth != null && request.auth.uid == userId; // Users can write their own
    }

    // fcmRecoveryJobs - written only by backend, read by any authenticated user (admin page)
    match /fcmRecoveryJobs/{userId} {
      allow read: if request.auth != null;
      allow write: if false; // Only backend (Admin SDK) writes here
    }

    // deviceNotifications - for FCM page notifications
    match /deviceNotifications/{notificationId} {
      allow read: if request.auth != null; // Admin can read all
      allow write: if request.auth != null; // Users can write their own notifications
    }

    // deviceStatus - for real-time device status
    match /deviceStatus/{userId} {
      allow read: if request.auth != null; // Admin can read any
      allow write: if request.auth != null && request.auth.uid == userId; // Users write their own
    }

    // Locations - allow authenticated users to read (admin verification is done in app)
    match /locations/{locationId} {
      allow read: if request.auth != null;
      allow write: if false; // Only backend can write
    }

    // Users collection - allow authenticated users to read
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Messages collection
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Orders collection
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Jobs collection
    match /jobs/{jobId} {
      allow read, write: if request.auth != null;
    }

    // Reviews collection
    match /reviews/{reviewId} {
      allow read, write: if request.auth != null;
    }

    // Deliveries collection
    match /deliveries/{deliveryId} {
      allow read, write: if request.auth != null;
    }

    // Allow backend (with admin token) to read/write everything else
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}


